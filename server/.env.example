NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5175
CORS_ORIGIN=http://localhost:5175
# Required — the server will refuse to start if this is missing. Use a long random string.
JWT_SECRET=your_super_secret_jwt_key_here
VERIFICATION_SESSION_SECRET=your_verification_session_secret_here
VERIFICATION_SESSION_TTL=1d
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=MediGuide <no-reply@example.com>
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH_HEADER=
SMS_WEBHOOK_AUTH_TOKEN=
SMS_SENDER_ID=MediGuide
GEMINI_MODEL=gemini-2.5-flash
